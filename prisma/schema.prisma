generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id Int @id @default(autoincrement())
  loginDevices LoginDevice[]
  targetedBans NetworkBan[] @relation("BanTarget")
  bansCreated NetworkBan[] @relation("BanCreator")
  bansRevoked NetworkBan[] @relation("BanRevoker")
  proxiesTrusted TrustedProxy[]
  email String? @unique
  username String @unique
  name String
  bio String @default("")
  bioPrivate Boolean @default(false)
  onlineVisible Boolean @default(true)
  messagesFrom String @default("everyone")
  links Json @default("[]")
  statsOffsets Json @default("{}")
  statCheckpoints StatCheckpoint[] @relation("CheckpointUser")
  statCheckpointsCreated StatCheckpoint[] @relation("CheckpointAdmin")
  statRestores StatRestore[] @relation("RestoreUser")
  statRestoresCreated StatRestore[] @relation("RestoreAdmin")
  savedMessages SavedMessage[]
  profileImages ProfileImage[]
  avatarKey String?
  bannerKey String?
  hasAvatar Boolean @default(false)
  hasBanner Boolean @default(false)
  mediaVersion Int @default(0)
  musicKey String?
  musicCoverKey String?
  hasMusicCover Boolean @default(false)
  musicMime String?
  musicTitle String @default("")
  musicArtist String @default("")
  musicVersion Int @default(0)
  hasMusic Boolean @default(false)
  badges BadgeAward[]
  gifts Gift[] @relation("GiftOwner")
  giftPurchases GiftPurchase[]
  giftEvents GiftEvent[] @relation("GiftSender")
  messageViews MessageView[]
  messageDeliveries MessageDelivery[]
  folders ChatFolder[]
  verified Boolean @default(false)
  plus Boolean @default(false)
  nameFont String @default("default")
  nameEffect String @default("none")
  profileAccent String @default("gold")
  collectibleNumber String? @unique
  identityReceived IdentityGrant[] @relation("IdentityRecipient")
  identityGranted IdentityGrant[] @relation("IdentityAdmin")
  passwordHash String
  emailVerified Boolean @default(false)
  nimbBalance Int @default(0)
  currencyReceived CurrencyGrant[] @relation("CurrencyRecipient")
  currencyGranted CurrencyGrant[] @relation("CurrencyAdmin")
  assetsReclaimed AssetReclaim[] @relation("ReclaimRecipient")
  assetsReclaimedBy AssetReclaim[] @relation("ReclaimAdmin")
  purchasedUsernames UsernamePurchase[]
  usernameGrants UsernamePurchase[] @relation("UsernameGrantAdmin")
  suspended Boolean @default(false)
  authTokens AuthToken[]
  createdAt DateTime @default(now())
  sessions Session[]
  memberships Member[]
  messages Message[]
  blocksMade Block[] @relation("Blocking")
  blocksReceived Block[] @relation("Blocked")
  reportsMade Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")
  posts Post[]
  postLikes PostLike[]
  reactions Reaction[]
  comments Comment[]
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")
}
model Session {
  clientIp String?
  deviceHash String?
  id String @id
  userId Int
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([clientIp])
  @@index([deviceHash])
}
model Chat {
  id Int @id @default(autoincrement())
  pairKey String? @unique
  kind String @default("direct")
  title String @default("")
  description String @default("")
  inviteHash String? @unique
  createdAt DateTime @default(now())
  members Member[]
  messages Message[]
  folderEntries FolderChat[]
  media CommunityMedia?
}
model Member {
  chatId Int
  userId Int
  role String @default("member")
  chatPinned Boolean @default(false)
  archived Boolean @default(false)
  lastReadId Int @default(0)
  chat Chat @relation(fields:[chatId], references:[id], onDelete: Cascade)
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  @@id([chatId,userId])
}
model Message {
  id Int @id @default(autoincrement())
  chatId Int
  senderId Int
  text String
  replyToId Int?
  pinned Boolean @default(false)
  forwarded Boolean @default(false)
  editedAt DateTime?
  replyTo Message? @relation("MessageReplies", fields:[replyToId], references:[id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")
  savedBy SavedMessage[]
  reactions Reaction[]
  views MessageView[]
  deliveries MessageDelivery[]
  attachment Attachment?
  createdAt DateTime @default(now())
  chat Chat @relation(fields:[chatId], references:[id], onDelete: Cascade)
  sender User @relation(fields:[senderId], references:[id], onDelete: Cascade)
  @@index([chatId,id])
  @@index([senderId])
}

model Block {
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker User @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
}
model Report {
  id Int @id @default(autoincrement())
  reporterId Int
  reportedId Int
  reason String
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  @@index([resolvedAt,id])
}
model Post {
  id Int @id @default(autoincrement())
  authorId Int
  text String
  createdAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes PostLike[]
  comments Comment[]
  image PostImage?
  @@index([id, authorId])
  @@index([authorId])
}
model PostLike {
  postId Int
  userId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId,userId])
}
model Comment {
  id Int @id @default(autoincrement())
  postId Int
  authorId Int
  text String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, id])
  @@index([authorId])
}
model Follow {
  followerId Int
  followingId Int
  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
  @@index([followingId])
}

model AuthToken {
  id String @id
  userId Int
  kind String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, kind])
}

model Reaction {
  messageId Int
  userId Int
  emoji String
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([messageId, userId, emoji])
  @@index([userId])
}

model Attachment {
  id Int @id @default(autoincrement())
  messageId Int @unique
  objectKey String @unique
  name String
  mime String
  size Int
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model BadgeAward {
  userId Int
  badge String
  awardedAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([userId,badge])
}
model Gift {
  id Int @id @default(autoincrement())
  editionId Int? @unique
  edition GiftEdition? @relation(fields:[editionId], references:[id], onDelete:Restrict)
  purchases GiftPurchase[]
  template String
  ownerId Int
  pinned Boolean @default(false)
  receivedAt DateTime @default(now())
  owner User @relation("GiftOwner", fields:[ownerId], references:[id], onDelete:Cascade)
  events GiftEvent[]
  @@index([ownerId,id])
}
model GiftEvent {
  id Int @id @default(autoincrement())
  giftId Int
  senderId Int
  createdAt DateTime @default(now())
  gift Gift @relation(fields:[giftId], references:[id], onDelete:Cascade)
  sender User @relation("GiftSender", fields:[senderId], references:[id], onDelete:Cascade)
}
model CurrencyGrant {
  id Int @id @default(autoincrement())
  recipientId Int
  adminId Int
  amount Int
  createdAt DateTime @default(now())
  recipient User @relation("CurrencyRecipient", fields:[recipientId], references:[id], onDelete:Cascade)
  admin User @relation("CurrencyAdmin", fields:[adminId], references:[id], onDelete:Restrict)
  @@index([recipientId, createdAt])
}
model AssetReclaim {
  id Int @id @default(autoincrement())
  requestId String @unique
  recipientId Int
  adminId Int
  kind String
  value String
  reason String
  balanceBefore Int
  balanceAfter Int
  replacementUsername String?
  checkpointId Int
  createdAt DateTime @default(now())
  recipient User @relation("ReclaimRecipient", fields:[recipientId], references:[id], onDelete:Cascade)
  admin User @relation("ReclaimAdmin", fields:[adminId], references:[id], onDelete:Restrict)
  checkpoint StatCheckpoint @relation(fields:[checkpointId], references:[id], onDelete:Restrict)
  @@index([recipientId,createdAt])
}
model UsernamePurchase {
  public Boolean @default(false)
  id Int @id @default(autoincrement())
  username String @unique
  ownerId Int
  price Int
  grantedById Int?
  grantedBy User? @relation("UsernameGrantAdmin", fields:[grantedById], references:[id], onDelete:SetNull)
  purchasedAt DateTime @default(now())
  owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  @@index([ownerId])
}
model PostImage {
  id Int @id @default(autoincrement())
  postId Int @unique
  objectKey String @unique
  post Post @relation(fields:[postId], references:[id], onDelete:Cascade)
}
model MessageView {
  messageId Int
  userId Int
  viewedAt DateTime @default(now())
  message Message @relation(fields:[messageId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([messageId,userId])
}

model PushSubscription {
  id Int @id @default(autoincrement())
  endpoint String @unique
  p256dh String
  auth String
  sessionId String
  session Session @relation(fields:[sessionId], references:[id], onDelete:Cascade)
  @@index([sessionId])
}

model ChatFolder {
  id Int @id @default(autoincrement())
  userId Int
  name String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  chats FolderChat[]
  @@index([userId,id])
}
model FolderChat {
  folderId Int
  chatId Int
  folder ChatFolder @relation(fields:[folderId], references:[id], onDelete:Cascade)
  chat Chat @relation(fields:[chatId], references:[id], onDelete:Cascade)
  @@id([folderId,chatId])
}

model CommunityMedia {
  chatId Int @id
  avatarKey String?
  bannerKey String?
  hasAvatar Boolean @default(false)
  hasBanner Boolean @default(false)
  version Int @default(0)
  chat Chat @relation(fields:[chatId], references:[id], onDelete:Cascade)
}

model MessageDelivery {
  messageId Int
  userId Int
  deliveredAt DateTime @default(now())
  message Message @relation(fields:[messageId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([messageId,userId])
}

model IdentityGrant {
  id Int @id @default(autoincrement())
  recipientId Int
  adminId Int
  kind String
  enabled Boolean
  createdAt DateTime @default(now())
  recipient User @relation("IdentityRecipient", fields:[recipientId], references:[id], onDelete:Cascade)
  admin User @relation("IdentityAdmin", fields:[adminId], references:[id], onDelete:Restrict)
  @@index([recipientId,createdAt])
}

model ProfileImage {
  userId Int
  kind String
  data Bytes
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([userId,kind])
}

model SavedMessage {
  id Int @id @default(autoincrement())
  userId Int
  messageId Int
  savedAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  message Message @relation(fields:[messageId], references:[id], onDelete:Cascade)
  @@unique([userId,messageId])
  @@index([userId,id])
}

model StatCheckpoint {
 id Int @id @default(autoincrement())
 userId Int
 adminId Int
 label String
 state Json
 createdAt DateTime @default(now())
 user User @relation("CheckpointUser", fields:[userId], references:[id], onDelete:Cascade)
 admin User @relation("CheckpointAdmin", fields:[adminId], references:[id], onDelete:Restrict)
 restoredFrom StatRestore[] @relation("RestoreSource")
 backups StatRestore[] @relation("RestoreBackup")
 reclaims AssetReclaim[]
 @@index([userId,id])
}
model StatRestore {
 id Int @id @default(autoincrement())
 userId Int
 adminId Int
 checkpointId Int
 backupId Int
 kind String
 createdAt DateTime @default(now())
 user User @relation("RestoreUser", fields:[userId], references:[id], onDelete:Cascade)
 admin User @relation("RestoreAdmin", fields:[adminId], references:[id], onDelete:Restrict)
 checkpoint StatCheckpoint @relation("RestoreSource", fields:[checkpointId], references:[id], onDelete:Restrict)
 backup StatCheckpoint @relation("RestoreBackup", fields:[backupId], references:[id], onDelete:Restrict)
 @@index([userId,id])
}

model WebPushConfig {
 id Int @id
 publicKey String
 privateKey String
 createdAt DateTime @default(now())
}

model LoginDevice {
 id Int @id @default(autoincrement())
 userId Int
 ip String
 deviceHash String
 label String
 firstSeen DateTime @default(now())
 lastSeen DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([userId,ip,deviceHash])
 @@index([userId,lastSeen])
}
model NetworkBan {
 id Int @id @default(autoincrement())
 kind String
 value String
 reason String
 targetUserId Int?
 createdById Int
 revokedById Int?
 createdAt DateTime @default(now())
 expiresAt DateTime?
 revokedAt DateTime?
 target User? @relation("BanTarget", fields:[targetUserId], references:[id], onDelete:SetNull)
 creator User @relation("BanCreator", fields:[createdById], references:[id], onDelete:Restrict)
 revoker User? @relation("BanRevoker", fields:[revokedById], references:[id], onDelete:SetNull)
 @@index([kind,value,revokedAt])
 @@index([targetUserId,id])
}
model TrustedProxy {
 ip String @id
 createdById Int
 createdAt DateTime @default(now())
 creator User @relation(fields:[createdById], references:[id], onDelete:Restrict)
}

// Editions survive stat rollbacks so collectible numbers and appearance never reroll.
model GiftEdition {
  id Int @id @default(autoincrement())
  originalGiftId Int @unique
  template String
  serialNumber Int
  backdrop String
  symbol String
  mintedAt DateTime @default(now())
  gift Gift?
  @@unique([template, serialNumber])
}
model GiftCounter {
  template String @id
  lastNumber Int
}
model GiftPurchase {
  requestId String @id
  originalGiftId Int
  userId Int
  template String
  giftId Int?
  price Int
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  gift Gift? @relation(fields:[giftId], references:[id], onDelete:SetNull)
  @@index([userId, createdAt])
}
