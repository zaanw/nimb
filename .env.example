DATABASE_URL="postgresql://nimb:nimb@localhost:5432/nimb?schema=public"
APP_ORIGIN="http://localhost:5173"
COOKIE_SECRET="replace-with-a-random-string-at-least-32-characters"
NODE_ENV="development"
PORT=3000

SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="nimb <noreply@example.test>"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="nimb"
S3_ACCESS_KEY="nimbminio"
S3_SECRET_KEY="nimbminio-local-only"
S3_CREATE_BUCKET="true"

# Для Web Push сгенерируйте отдельные VAPID-ключи; оставьте пустыми, чтобы отключить push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Числовые ID администраторов через запятую, например 1,2. Пустое значение отключает панель.
ADMIN_USER_IDS=""

# Необязательно: для Render можно использовать Brevo через HTTPS вместо SMTP.
MAIL_PROVIDER="smtp"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="nimb"
